<div class="pl-4 pr-4 pt-2">
  <!-- Breadcrumb / Navigation -->
  <div class="mb-6">
    <nav class="flex items-center gap-2 text-sm text-muted">
      <a routerLink="/" class="link">Home</a>
      <span>/</span>
      <a [routerLink]="['/categories', category()]" class="link">{{ category() }}</a>
      <span>/</span>
      <span class="font-medium">Group: {{ groupName() }}</span>
    </nav>
  </div>

  @if (loading()) {
    <div class="flex items-center justify-center py-16">
      <div class="text-center">
        <div
          class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-500 mx-auto"
        ></div>
        <p class="mt-4 text-muted">Loading group members...</p>
      </div>
    </div>
  } @else {
    <!-- Group Header -->
    <div class="card mb-6">
      <div class="card-body">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div>
            <h1 class="heading-page">{{ groupName() }}</h1>
            <p class="text-muted mt-1">
              Text model group with {{ canonicalMembers().length }} canonical model{{
                canonicalMembers().length === 1 ? '' : 's'
              }}
              @if (backendDuplicates().length > 0) {
                and {{ backendDuplicates().length }} backend duplicate{{
                  backendDuplicates().length === 1 ? '' : 's'
                }}
              }
              @if (pendingGroupChanges().length > 0) {
                <span class="ml-2 badge badge-warning badge-sm">
                  {{ pendingGroupChanges().length }} pending
                </span>
              }
            </p>
            @if (parameterSummary()) {
              <div class="flex flex-wrap gap-2 mt-2">
                @for (size of parameterSummary()!; track size) {
                  <span class="tag tag-info">{{ size }}</span>
                }
              </div>
            }
            <!-- Family & Aliases -->
            <div class="flex flex-wrap items-center gap-3 mt-2">
              @if (relatedFamily(); as family) {
                <span class="text-sm">
                  <span class="text-muted">Family:</span>
                  <horde-badge variant="info">{{ family.family_name }}</horde-badge>
                  @if (family.members.length > 1) {
                    <span class="text-xs text-muted ml-1">
                      ({{ family.members.length }} groups)
                    </span>
                  }
                </span>
              }
              @if (groupAliases().length > 0) {
                <span class="text-sm">
                  <span class="text-muted">Aliases:</span>
                  @for (alias of groupAliases(); track alias) {
                    <span class="badge badge-secondary text-xs ml-1">{{ alias }}</span>
                  }
                </span>
              }
            </div>
          </div>
          <div class="flex gap-2 flex-shrink-0">
            <horde-button variant="secondary" (click)="goBackToList()">← Back to List</horde-button>
            @if (writable()) {
              <horde-button variant="primary" (click)="openAddVariation()"
                >+ Add Variation</horde-button
              >
              <horde-button variant="secondary" (click)="openMultiVariation()"
                >⊞ Batch Create</horde-button
              >
            }
            @if (writable() && canonicalMembers().length > 1 && !deletingAll()) {
              <horde-button variant="danger" (click)="confirmDeleteAll()">Delete All</horde-button>
            }
          </div>
        </div>
      </div>
    </div>

    <!-- Health Warnings -->
    @if (healthWarnings().length > 0) {
      <div class="alert alert--warning mb-6">
        <strong>Group Health Check</strong>
        <ul class="mt-1 ml-4 list-disc text-sm">
          @for (warning of healthWarnings(); track warning) {
            <li>{{ warning }}</li>
          }
        </ul>
      </div>
    }

    <!-- Pending Changes Section -->
    @if (pendingGroupChanges().length > 0) {
      <div class="card mb-6 border-warning-300 dark:border-warning-700">
        <div class="card-header">
          <div class="flex items-center gap-2">
            <h2 class="heading-section">Pending Changes</h2>
            <span class="badge badge-warning badge-sm">{{ pendingGroupChanges().length }}</span>
          </div>
          <p class="text-sm text-muted mt-1">
            These changes are awaiting approval and are not yet live.
          </p>
        </div>
        <div class="card-body p-0">
          <div class="overflow-x-auto">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Model Name</th>
                  <th>Operation</th>
                  <th>Requested By</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                @for (change of pendingGroupChanges(); track change.change_id) {
                  <tr class="ghost-row">
                    <td class="font-medium text-gray-900 dark:text-gray-100">
                      {{ change.model_name }}
                    </td>
                    <td>
                      @switch (change.operation) {
                        @case ('create') {
                          <horde-badge variant="success">Create</horde-badge>
                        }
                        @case ('update') {
                          <horde-badge variant="warning">Update</horde-badge>
                        }
                        @case ('delete') {
                          <horde-badge variant="danger">Delete</horde-badge>
                        }
                        @default {
                          <horde-badge variant="secondary">{{ change.operation }}</horde-badge>
                        }
                      }
                    </td>
                    <td>{{ change.requested_username || 'Unknown' }}</td>
                    <td>
                      <horde-badge variant="warning">{{ change.status }}</horde-badge>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    }

    <!-- Add Variation Panel -->
    @if (showAddVariation()) {
      <app-add-variation-panel
        [groupName]="groupName()"
        [groupData]="groupData()!"
        (created)="onVariationCreated()"
        (dirtyChange)="onAddVariationDirtyChange($event)"
        (cancelled)="closeAddVariation()"
      />
    }

    <!-- Multi-Variation Panel -->
    @if (showMultiVariation()) {
      <app-multi-variation-panel
        [groupName]="groupName()"
        [groupData]="groupData()!"
        (created)="onMultiVariationCreated()"
        (dirtyChange)="onMultiVariationDirtyChange($event)"
        (cancelled)="closeMultiVariation()"
      />
    }

    <!-- Name Schema Editor -->
    @if (groupData()) {
      <app-name-schema-editor
        [groupName]="groupName()"
        [nameFormat]="groupData()!.name_format"
        [isCustom]="nameSchemaIsCustom()"
        [writable]="writable()"
        (schemaChanged)="onSchemaChanged()"
      />
    }

    <!-- Common Fields Panel -->
    @if (groupData() && Object.keys(commonFields()).length > 0) {
      <div
        class="card mb-6 transition-colors duration-200"
        [class.border-primary-300]="editingCommonFields()"
        [class.dark:border-primary-700]="editingCommonFields()"
        [class.bg-primary-50/30]="editingCommonFields()"
        [class.dark:bg-primary-950/20]="editingCommonFields()"
      >
        <div class="card-header flex items-center justify-between">
          <div>
            <h2 class="heading-section">Shared Fields</h2>
            <p class="text-sm text-muted mt-1">
              Fields identical across all {{ canonicalMembers().length }} canonical members.
            </p>
            @if (editingCommonFields()) {
              <p class="text-xs text-primary-700 dark:text-primary-300 mt-1 font-medium">
                Editing mode is active.
              </p>
            }
          </div>
          @if (editingCommonFields()) {
            <span class="badge badge-info">Editing</span>
          } @else if (writable()) {
            <horde-button variant="secondary" size="sm" (click)="startEditingCommonFields()">
              Edit Shared
            </horde-button>
          }
        </div>
        <div class="card-body">
          @if (editingCommonFields()) {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              @if (commonFieldEdits()['baseline'] !== undefined) {
                <div>
                  <label class="form-label" for="edit-baseline">Baseline</label>
                  <input
                    id="edit-baseline"
                    type="text"
                    class="form-input"
                    [ngModel]="commonFieldEdits()['baseline']"
                    (ngModelChange)="updateCommonFieldEdit('baseline', $event)"
                  />
                </div>
              }
              @if (commonFieldEdits()['description'] !== undefined) {
                <div class="md:col-span-2">
                  <label class="form-label" for="edit-description">Description</label>
                  <textarea
                    id="edit-description"
                    class="form-textarea"
                    rows="2"
                    [ngModel]="commonFieldEdits()['description']"
                    (ngModelChange)="updateCommonFieldEdit('description', $event)"
                  ></textarea>
                </div>
              }
              @if (commonFieldEdits()['url'] !== undefined) {
                <div>
                  <label class="form-label" for="edit-url">URL</label>
                  <input
                    id="edit-url"
                    type="url"
                    class="form-input"
                    [ngModel]="commonFieldEdits()['url']"
                    (ngModelChange)="updateCommonFieldEdit('url', $event)"
                  />
                </div>
              }
              @if (commonFieldEdits()['nsfw'] !== undefined) {
                <div>
                  <label class="form-label" for="edit-nsfw">NSFW</label>
                  <input
                    id="edit-nsfw"
                    type="checkbox"
                    class="checkbox-input"
                    [ngModel]="commonFieldEdits()['nsfw']"
                    (ngModelChange)="updateCommonFieldEdit('nsfw', $event)"
                  />
                </div>
              }
            </div>

            <!-- What-would-change preview -->
            @if (commonFieldsDirty()) {
              <div
                class="mt-4 p-3 rounded-lg border border-warning-200 dark:border-warning-700 bg-warning-50 dark:bg-warning-900/20"
              >
                <h4 class="text-sm font-semibold mb-2">
                  Preview: {{ canonicalMembers().length }} model(s) will be updated
                </h4>
                <div class="space-y-1">
                  @for (change of commonFieldsPreview(); track change.field) {
                    <div class="text-sm font-mono">
                      <span class="font-semibold">{{ change.field }}</span
                      >:
                      <span class="line-through text-danger-600 dark:text-danger-400">{{
                        change.from === true ? 'Yes' : change.from === false ? 'No' : change.from
                      }}</span>
                      →
                      <span class="text-success-600 dark:text-success-400">{{
                        change.to === true ? 'Yes' : change.to === false ? 'No' : change.to
                      }}</span>
                    </div>
                  }
                </div>
                <p class="text-xs text-muted mt-2">
                  Changes are queued for approval and do not take effect immediately.
                </p>
              </div>
            }

            <div class="flex gap-2 mt-4">
              <horde-button
                variant="primary"
                [disabled]="savingCommonFields()"
                (click)="saveCommonFields()"
              >
                {{
                  savingCommonFields()
                    ? 'Saving...'
                    : 'Save (queues ' + canonicalMembers().length + ' updates)'
                }}
              </horde-button>
              <horde-button variant="secondary" (click)="cancelEditingCommonFields()"
                >Cancel</horde-button
              >
            </div>
          } @else {
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
              @for (entry of Object.entries(commonFields()); track entry[0]) {
                <div>
                  <span class="field-label">{{ entry[0] }}</span>
                  <span class="field-value block mt-0.5">
                    @if (entry[1] === true || entry[1] === false) {
                      {{ entry[1] ? 'Yes' : 'No' }}
                    } @else if (isArray(entry[1])) {
                      {{ asStringArray(entry[1]).join(', ') }}
                    } @else {
                      {{ entry[1] }}
                    }
                  </span>
                </div>
              }
            </div>
          }
        </div>
      </div>
    }

    <!-- Canonical Members -->
    @if (canonicalMembers().length > 0) {
      <!-- Size Sub-Groups for large groups -->
      @if (useSizeSubGroups()) {
        <div class="space-y-4 mb-6">
          @for (subGroup of sizeSubGroups(); track subGroup.size) {
            <div class="card">
              <button
                class="card-header cursor-pointer flex items-center justify-between w-full text-left"
                (click)="toggleSizeGroup(subGroup)"
              >
                <div class="flex items-center gap-3">
                  <span class="text-lg font-mono">{{ subGroup.expanded ? '▼' : '▶' }}</span>
                  <h2 class="heading-section">{{ subGroup.size }}</h2>
                  <span class="tag tag-secondary"
                    >{{ subGroup.members.length }} variant{{
                      subGroup.members.length === 1 ? '' : 's'
                    }}</span
                  >
                </div>
              </button>
              @if (subGroup.expanded) {
                <div class="card-body p-0">
                  <div class="overflow-x-auto">
                    <table class="data-table">
                      <thead>
                        <tr>
                          <th>Name</th>
                          <th>Variant</th>
                          <th>Quant</th>
                          <th>Params</th>
                          <th>NSFW</th>
                          @if (exceptionMembers().length > 0) {
                            <th>Exception</th>
                          }
                          @if (writable()) {
                            <th class="text-center">Actions</th>
                          }
                        </tr>
                      </thead>
                      <tbody>
                        @for (member of subGroup.members; track member.name) {
                          <tr>
                            <td class="font-medium text-gray-900 dark:text-gray-100">
                              <div class="flex flex-col">
                                <span>{{ member.name }}</span>
                                @if (member.display_name && member.display_name !== member.name) {
                                  <span class="text-xs text-muted">{{ member.display_name }}</span>
                                }
                              </div>
                            </td>
                            <td>{{ member.parsed.variant ?? '-' }}</td>
                            <td>
                              @if (member.parsed.quant) {
                                <span class="tag tag-secondary">{{ member.parsed.quant }}</span>
                              } @else {
                                <span class="text-muted">-</span>
                              }
                            </td>
                            <td>
                              @if (member.parameters) {
                                <span class="tag tag-info">{{
                                  formatParams(member.parameters)
                                }}</span>
                              } @else {
                                <span class="text-muted">-</span>
                              }
                            </td>
                            <td>
                              @if (member.nsfw === true) {
                                <horde-badge variant="warning">NSFW</horde-badge>
                              } @else if (member.nsfw === false) {
                                <horde-badge variant="success">SFW</horde-badge>
                              } @else {
                                <horde-badge variant="secondary">Unknown</horde-badge>
                              }
                            </td>
                            @if (exceptionMembers().length > 0) {
                              <td>
                                @if (exceptionMemberNames().has(member.name)) {
                                  <span
                                    class="tag tag-warning"
                                    [title]="getExceptionReason(member.name) ?? ''"
                                  >
                                    ⚠ {{ getExceptionReason(member.name) }}
                                  </span>
                                }
                              </td>
                            }
                            @if (writable()) {
                              <td class="text-center">
                                <div class="flex gap-2 justify-center whitespace-nowrap">
                                  <horde-button
                                    variant="primary"
                                    size="sm"
                                    (click)="editMember(member)"
                                  >
                                    Edit
                                  </horde-button>
                                  <horde-button
                                    variant="danger"
                                    size="sm"
                                    (click)="confirmDeleteMember(member)"
                                  >
                                    Delete
                                  </horde-button>
                                </div>
                              </td>
                            }
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                </div>
              }
            </div>
          }
        </div>
      } @else {
        <!-- Flat table for small groups -->
        <div class="card mb-6">
          <div class="card-header">
            <h2 class="heading-section">Canonical Models</h2>
            <p class="text-sm text-muted mt-1">
              These are the actual model records. Backend duplicates are auto-generated from these.
            </p>
          </div>
          <div class="card-body p-0">
            <div class="overflow-x-auto">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Size</th>
                    <th>Variant</th>
                    <th>Quant</th>
                    <th>Params</th>
                    <th>Baseline</th>
                    <th>NSFW</th>
                    <th>Description</th>
                    @if (exceptionMembers().length > 0) {
                      <th>Exception</th>
                    }
                    @if (writable()) {
                      <th class="text-center">Actions</th>
                    }
                  </tr>
                </thead>
                <tbody>
                  @for (member of canonicalMembers(); track member.name) {
                    <tr>
                      <td class="font-medium text-gray-900 dark:text-gray-100">
                        <div class="flex flex-col">
                          <span>{{ member.name }}</span>
                          @if (member.display_name && member.display_name !== member.name) {
                            <span class="text-xs text-muted">{{ member.display_name }}</span>
                          }
                        </div>
                      </td>
                      <td>
                        @if (member.parsed.size) {
                          <span class="tag tag-info">{{ member.parsed.size }}</span>
                        } @else {
                          <span class="text-muted">-</span>
                        }
                      </td>
                      <td>{{ member.parsed.variant ?? '-' }}</td>
                      <td>
                        @if (member.parsed.quant) {
                          <span class="tag tag-secondary">{{ member.parsed.quant }}</span>
                        } @else {
                          <span class="text-muted">-</span>
                        }
                      </td>
                      <td>
                        @if (member.parameters) {
                          <span class="tag tag-info">{{ formatParams(member.parameters) }}</span>
                        } @else {
                          <span class="text-muted">-</span>
                        }
                      </td>
                      <td>{{ member.baseline ?? '-' }}</td>
                      <td>
                        @if (member.nsfw === true) {
                          <horde-badge variant="warning">NSFW</horde-badge>
                        } @else if (member.nsfw === false) {
                          <horde-badge variant="success">SFW</horde-badge>
                        } @else {
                          <horde-badge variant="secondary">Unknown</horde-badge>
                        }
                      </td>
                      <td>
                        <div class="truncate max-w-xs" [title]="member.description ?? ''">
                          {{ member.description ?? '-' }}
                        </div>
                      </td>
                      @if (exceptionMembers().length > 0) {
                        <td>
                          @if (exceptionMemberNames().has(member.name)) {
                            <span
                              class="tag tag-warning"
                              [title]="getExceptionReason(member.name) ?? ''"
                            >
                              ⚠ {{ getExceptionReason(member.name) }}
                            </span>
                          }
                        </td>
                      }
                      @if (writable()) {
                        <td class="text-center">
                          <div class="flex gap-2 justify-center whitespace-nowrap">
                            <horde-button variant="primary" size="sm" (click)="editMember(member)">
                              Edit
                            </horde-button>
                            <horde-button
                              variant="danger"
                              size="sm"
                              (click)="confirmDeleteMember(member)"
                            >
                              Delete
                            </horde-button>
                          </div>
                        </td>
                      }
                    </tr>
                  }
                </tbody>
              </table>
            </div>
          </div>
        </div>
      }
    }

    <!-- Backend Duplicates Section -->
    @if (backendDuplicates().length > 0) {
      <div class="card mb-6">
        <div class="card-header">
          <h2 class="heading-section">Backend Duplicates</h2>
          <p class="text-sm text-muted mt-1">
            These entries are auto-generated by the backend for compatibility with different
            inference engines. They inherit all properties from their canonical record and cannot be
            edited independently.
          </p>
        </div>
        <div class="card-body p-0">
          <div class="overflow-x-auto">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Full Name</th>
                  <th>Backend</th>
                  <th>Parameters</th>
                  <th>Baseline</th>
                </tr>
              </thead>
              <tbody>
                @for (dup of backendDuplicates(); track dup.name) {
                  <tr>
                    <td class="font-mono text-sm text-gray-900 dark:text-gray-100">
                      {{ dup.name }}
                    </td>
                    <td>
                      <horde-badge variant="info">{{ dup.backend_prefix }}</horde-badge>
                    </td>
                    <td>
                      @if (dup.parameters) {
                        <span class="tag tag-info">{{ formatParams(dup.parameters) }}</span>
                      } @else {
                        <span class="text-muted">-</span>
                      }
                    </td>
                    <td>{{ dup.baseline ?? '-' }}</td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>
    }

    <!-- Empty State -->
    @if (!groupData() && pendingGroupChanges().length === 0) {
      <div class="card">
        <div class="card-body text-center py-12">
          <p class="text-lg text-muted">No models found in this group.</p>
          <horde-button variant="primary" class="mt-4" (click)="goBackToList()"
            >Back to Model List</horde-button
          >
        </div>
      </div>
    } @else if (groupData()?.members?.length === 0 && pendingGroupChanges().length === 0) {
      <div class="card">
        <div class="card-body text-center py-12">
          <p class="text-lg text-muted">No models found in this group.</p>
          <horde-button variant="primary" class="mt-4" (click)="goBackToList()"
            >Back to Model List</horde-button
          >
        </div>
      </div>
    } @else if (!groupData() && pendingGroupChanges().length > 0) {
      <div class="card">
        <div class="card-body text-center py-12">
          <p class="text-lg text-muted">
            This group has no live models yet. All entries are pending approval.
          </p>
        </div>
      </div>
    }

    <!-- Delete Single Model Modal -->
    @if (modelToDelete()) {
      <div
        class="modal-overlay"
        tabindex="0"
        (click)="cancelDelete()"
        (keydown)="$event.key === 'Escape' && cancelDelete()"
        aria-label="Close modal"
      >
        <div
          class="modal-dialog"
          (click)="$event.stopPropagation()"
          (keydown)="$event.stopPropagation()"
          aria-modal="true"
          role="dialog"
        >
          <h3 class="modal-title">Delete Model</h3>
          <div class="modal-content">
            <p class="mb-4">
              Are you sure you want to delete <strong>{{ modelToDelete() }}</strong
              >?
            </p>
            <p class="text-sm text-muted mb-3">Type the model name to confirm:</p>
            <input
              id="delete-model-confirm"
              type="text"
              class="form-input"
              [placeholder]="modelToDelete()!"
              [ngModel]="deleteConfirmationInput()"
              (ngModelChange)="deleteConfirmationInput.set($event)"
            />
          </div>
          <div class="modal-actions">
            <horde-button variant="secondary" (click)="cancelDelete()">Cancel</horde-button>
            <horde-button
              variant="danger"
              [disabled]="!deleteAllowed()"
              (click)="deleteMember(modelToDelete()!)"
            >
              Delete
            </horde-button>
          </div>
        </div>
      </div>
    }

    <!-- Delete All Models Modal -->
    @if (deletingAll()) {
      <div
        class="modal-overlay"
        tabindex="0"
        (click)="cancelDeleteAll()"
        (keydown)="$event.key === 'Escape' && cancelDeleteAll()"
        aria-label="Close modal"
      >
        <div
          class="modal-dialog"
          (click)="$event.stopPropagation()"
          (keydown)="$event.stopPropagation()"
          aria-modal="true"
          role="dialog"
        >
          <h3 class="modal-title">Delete All Models in Group</h3>
          <div class="modal-content">
            <div class="alert alert--danger mb-4">
              <strong>Warning:</strong> This will delete all
              {{ canonicalMembers().length }} canonical model{{
                canonicalMembers().length === 1 ? '' : 's'
              }}
              in the "{{ groupName() }}" group. Backend duplicates will be removed automatically.
            </div>
            <p class="text-sm text-muted mb-3">
              Type the group name (<strong>{{ groupName() }}</strong
              >) to confirm:
            </p>
            <input
              id="delete-all-confirm"
              type="text"
              class="form-input"
              [placeholder]="groupName()"
              [ngModel]="deleteAllVariantsConfirmation()"
              (ngModelChange)="deleteAllVariantsConfirmation.set($event)"
            />
          </div>
          <div class="modal-actions">
            <horde-button variant="secondary" (click)="cancelDeleteAll()">Cancel</horde-button>
            <horde-button
              variant="danger"
              [disabled]="!deleteAllAllowed()"
              (click)="deleteAllMembers()"
            >
              Delete All ({{ canonicalMembers().length }})
            </horde-button>
          </div>
        </div>
      </div>
    }
  }
</div>
