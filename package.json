{
  "name": "horde-model-reference-frontend",
  "version": "0.0.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "verify:design-system": "node scripts/verify-design-system.js",
    "prestart": "npm run verify:design-system",
    "start": "ng serve",
    "prebuild": "npm run verify:design-system",
    "build": "ng build",
    "build:ci": "npm run build -- --configuration=production",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "prewatch": "npm run verify:design-system",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run verify:design-system",
    "test": "ng test --watch=false",
    "test:ci": "npm test -- --watch=false --coverage",
    "test:e2e": "playwright test",
    "pretype-check": "npm run verify:design-system",
    "type-check": "npx tsc --noEmit -p tsconfig.app.json && npx tsc --noEmit -p tsconfig.spec.json",
    "ci:local": "npm run lint && npm run type-check && npm run test:ci && npm run build:ci",
    "ci:openapi": "npm run generate-client -- --url http://localhost:19800/api/openapi.json && git diff --exit-code -- src/app/api-client src/assets/openapi-schema.json",
    "precommit:quick": "lint-staged",
    "precommit:verify": "npm run precommit:quick && npm run type-check",
    "generate-client": "node scripts/generate-api-client.js",
    "generate-client:local": "node scripts/generate-api-client.js --local",
    "prelint": "npm run verify:design-system",
    "lint": "ng lint && prettier --check .",
    "lint:fix": "ng lint --fix && prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --max-warnings=0 --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{scss,css,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@playwright/test": "^1.62.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "flatted": "^3.4.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "postcss-import": "^17.0.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0",
    "undici": "^8.10.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "picomatch": "4.0.4"
  }
}
